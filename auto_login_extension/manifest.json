{
  "manifest_version": 3,
  "name": "OTG Trade Live Auto Login",
  "version": "1.3.0",
  "description": "Автоматический вход и голосовой мост AIZI для live-презентации.",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://aizi-chat.trade.kg/*",
    "https://test-tnved.trade.kg/*",
    "https://ai.trade.kg/*",
    "https://ocr.trade.kg/*",
    "https://cost-tovar.trade.kg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aizi-chat.trade.kg/*",
        "https://test-tnved.trade.kg/*",
        "https://ai.trade.kg/*",
        "https://ocr.trade.kg/*",
        "https://cost-tovar.trade.kg/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "aizi_iframe_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
